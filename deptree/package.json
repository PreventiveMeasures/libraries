{
  "name": "@preventive/deptree",
  "version": "1.0.0-alpha.0",
  "description": "A node_modules tree in memory, as a package manager would install it: pnpm 10 from its lockfile, tarballs fetched and checked, patches applied",
  "type": "module",
  "exports": {
    "./pnpm.js": {
      "types": "./pnpm.d.ts",
      "default": "./pnpm.js"
    }
  },
  "files": [
    "pnpm.d.ts",
    "pnpm.js",
    "src/error.js",
    "src/hash.js",
    "src/matcher.js",
    "src/patch.js",
    "src/pnpm/filename.js",
    "src/pnpm/graph.js",
    "src/pnpm/hoist.js",
    "src/pnpm/install.js",
    "src/pnpm/npmrc.js",
    "src/pnpm/overrides.js",
    "src/pnpm/settings.js",
    "src/pnpm/tree.js",
    "src/pnpm/uptodate.js",
    "src/tarball.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreventiveMeasures/libraries.git",
    "directory": "deptree"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/deptree",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@preventive/archive": "1.0.0-beta.3",
    "@preventive/diff": "^1.0.0",
    "@preventive/lockfile": "1.0.0-alpha.0",
    "@preventive/upstream": "1.0.0-alpha.0",
    "@preventive/vfs": "1.0.0-beta.1"
  }
}
