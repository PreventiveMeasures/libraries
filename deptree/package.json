{
  "name": "@preventive/deptree",
  "version": "1.0.0-alpha.2",
  "description": "A node_modules tree in memory, as a package manager would install it: pnpm 10 or 11, or yarn 1.22, from its lockfile, tarballs fetched and checked, patches applied",
  "type": "module",
  "exports": {
    "./pnpm.js": {
      "types": "./pnpm.d.ts",
      "default": "./pnpm.js"
    },
    "./yarn1.js": {
      "types": "./yarn1.d.ts",
      "default": "./yarn1.js"
    }
  },
  "files": [
    "pnpm.d.ts",
    "pnpm.js",
    "yarn1.d.ts",
    "yarn1.js",
    "src/concurrent.js",
    "src/error.js",
    "src/hash.js",
    "src/matcher.js",
    "src/mount.js",
    "src/patch.js",
    "src/pnpm/bins.js",
    "src/pnpm/checks.js",
    "src/pnpm/filename.js",
    "src/pnpm/frozen.js",
    "src/pnpm/graph.js",
    "src/pnpm/hook.js",
    "src/pnpm/hoist.js",
    "src/pnpm/inputs.js",
    "src/pnpm/install.js",
    "src/pnpm/local.js",
    "src/pnpm/npmrc.js",
    "src/pnpm/overrides.js",
    "src/pnpm/packlist.js",
    "src/pnpm/patches.js",
    "src/pnpm/project.js",
    "src/pnpm/projects.js",
    "src/pnpm/readers.js",
    "src/pnpm/settings.js",
    "src/pnpm/tree.js",
    "src/pnpm/uptodate.js",
    "src/pnpm/workspace.js",
    "src/tarball.js",
    "src/yarn1/bins.js",
    "src/yarn1/compat.js",
    "src/yarn1/glob.js",
    "src/yarn1/hoist.js",
    "src/yarn1/inputs.js",
    "src/yarn1/manifest.js",
    "src/yarn1/package.js",
    "src/yarn1/peers.js",
    "src/yarn1/requests.js",
    "src/yarn1/resolve.js",
    "src/yarn1/settings.js",
    "src/yarn1/tree.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreventiveMeasures/libraries.git",
    "directory": "deptree"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/deptree",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@preventive/archive": "1.0.0-beta.3",
    "@preventive/diff": "^1.0.0",
    "@preventive/lockfile": "1.0.0-alpha.2",
    "@preventive/upstream": "1.0.0-alpha.2",
    "@preventive/vfs": "1.0.0-beta.2"
  }
}
