{
  "name": "@preventive/lockfile",
  "version": "1.0.0-alpha.2",
  "description": "Strict lockfile readers: pnpm-lock.yaml v9, yarn.lock v1 and soldeer.lock checked field by field, their packages and graph resolved, and the YAML and TOML parsers beside them",
  "type": "module",
  "exports": {
    "./pnpm.js": {
      "types": "./pnpm.d.ts",
      "default": "./pnpm.js"
    },
    "./soldeer.js": {
      "types": "./soldeer.d.ts",
      "default": "./soldeer.js"
    },
    "./yaml.js": {
      "types": "./yaml.d.ts",
      "default": "./yaml.js"
    },
    "./toml.js": {
      "types": "./toml.d.ts",
      "default": "./toml.js"
    },
    "./yarn1.js": {
      "types": "./yarn1.d.ts",
      "default": "./yarn1.js"
    }
  },
  "files": [
    "pnpm.d.ts",
    "pnpm.js",
    "soldeer.d.ts",
    "soldeer.js",
    "src/error.js",
    "src/graph.js",
    "src/names.js",
    "src/pnpm/importers.js",
    "src/pnpm/key.js",
    "src/pnpm/packages.js",
    "src/pnpm/parse.js",
    "src/pnpm/resolution.js",
    "src/shape.js",
    "src/soldeer/config.js",
    "src/soldeer/parse.js",
    "src/soldeer/sanitize.js",
    "src/soldeer/semver.js",
    "src/toml/datetime.js",
    "src/toml/error.js",
    "src/toml/number.js",
    "src/toml/parse.js",
    "src/toml/value.js",
    "src/yaml/error.js",
    "src/yaml/parse.js",
    "src/yaml/scalar.js",
    "src/yarn1/glob.js",
    "src/yarn1/importers.js",
    "src/yarn1/packages.js",
    "src/yarn1/parse.js",
    "src/yarn1/resolutions.js",
    "src/yarn1/syntax.js",
    "toml.d.ts",
    "toml.js",
    "yaml.d.ts",
    "yaml.js",
    "yarn1.d.ts",
    "yarn1.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js ./tests/soldeer/*.test.js ./tests/toml/*.test.js ./tests/yaml/*.test.js ./tests/yarn1/*.test.js"
  },
  "license": "MIT",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreventiveMeasures/libraries.git",
    "directory": "lockfile"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/lockfile",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0"
  }
}
