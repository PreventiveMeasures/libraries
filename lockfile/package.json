{
  "name": "@preventive/lockfile",
  "version": "0.0.0",
  "description": "Strict lockfile reader: pnpm-lock.yaml v9 checked field by field, its packages and graph resolved",
  "type": "module",
  "exports": {
    "./pnpm.js": {
      "types": "./pnpm.d.ts",
      "default": "./pnpm.js"
    }
  },
  "files": [
    "pnpm.d.ts",
    "pnpm.js",
    "src/error.js",
    "src/names.js",
    "src/pnpm/importers.js",
    "src/pnpm/key.js",
    "src/pnpm/packages.js",
    "src/pnpm/parse.js",
    "src/pnpm/resolution.js",
    "src/shape.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PreventiveMeasures/libraries.git",
    "directory": "lockfile"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/lockfile",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@preventive/yaml": "workspace:^"
  }
}
