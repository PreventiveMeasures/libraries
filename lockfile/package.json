{
  "name": "@preventive/lockfile",
  "version": "1.0.0-alpha.4",
  "description": "Strict lockfile readers: pnpm-lock.yaml v9, package-lock.json v3, yarn.lock v1, soldeer.lock, foundry.lock, Cargo.lock v3 and v4, uv.lock, poetry.lock and pylock.toml, checked field by field, their packages and graphs resolved, with Cargo.toml, vendored copies and cargo's features, and the YAML, TOML and Rust semver parsers beside them",
  "type": "module",
  "exports": {
    "./foundry.js": {
      "types": "./foundry.d.ts",
      "default": "./foundry.js"
    },
    "./npm.js": {
      "types": "./npm.d.ts",
      "default": "./npm.js"
    },
    "./pnpm.js": {
      "types": "./pnpm.d.ts",
      "default": "./pnpm.js"
    },
    "./cargo.js": {
      "types": "./cargo.d.ts",
      "default": "./cargo.js"
    },
    "./poetry.js": {
      "types": "./poetry.d.ts",
      "default": "./poetry.js"
    },
    "./pylock.js": {
      "types": "./pylock.d.ts",
      "default": "./pylock.js"
    },
    "./soldeer.js": {
      "types": "./soldeer.d.ts",
      "default": "./soldeer.js"
    },
    "./uv.js": {
      "types": "./uv.d.ts",
      "default": "./uv.js"
    },
    "./yaml.js": {
      "types": "./yaml.d.ts",
      "default": "./yaml.js"
    },
    "./toml.js": {
      "types": "./toml.d.ts",
      "default": "./toml.js"
    },
    "./yarn1.js": {
      "types": "./yarn1.d.ts",
      "default": "./yarn1.js"
    },
    "./rust-semver.js": {
      "types": "./rust-semver.d.ts",
      "default": "./rust-semver.js"
    }
  },
