{
    "name": "fixture/project",
    "description": "Every kind of package a lockfile records.",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./packages/local"
        },
        {
            "type": "vcs",
            "url": "./repos/vcs"
        },
        {
            "type": "package",
            "package": {
                "name": "fixture/inline",
                "version": "2.0.0",
                "dist": {
                    "type": "zip",
                    "url": "https://example.com/inline-2.0.0.zip",
                    "shasum": "0123456789abcdef0123456789abcdef01234567"
                },
                "source": {
                    "type": "git",
                    "url": "https://example.com/inline.git",
                    "reference": "v2.0.0"
                },
                "require": {
                    "php": ">=7.4"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "fixture/inline": "^2.0",
        "fixture/local": "*",
        "fixture/vcs": "dev-main as 1.1.0",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.0",
        "ramsey/uuid": "^4.7",
        "symfony/polyfill-mbstring": "^1.30"
    },
    "require-dev": {
        "doctrine/cache": "^2.2@stable",
        "ext-mbstring": "*",
        "php-http/message-factory": "^1.1",
        "symfony/var-dumper": "^7.0@beta"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
