{
  "profile": {
    "default": {
      "fs_permissions": [
        {
          "access": "read-write",
          "path": "./"
        }
      ],
      "optimizer": true,
      "optimizer_runs": 200,
      "ignored_error_codes": [
        3860
      ]
    }
  },
  "rpc_endpoints": {
    "mainnet": "https://ethereum.reth.rs/rpc",
    "optimism_sepolia": "https://sepolia.optimism.io/",
    "arbitrum_one_sepolia": "https://sepolia-rollup.arbitrum.io/rpc/",
    "needs_undefined_env_var": "${UNDEFINED_RPC_URL_PLACEHOLDER}"
  },
  "lint": {
    "lint_on_build": false
  }
}
