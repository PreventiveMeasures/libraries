{
  "package": {
    "name": "regex",
    "version": "1.11.1",
    "authors": [
      "The Rust Project Developers",
      "Andrew Gallant <jamslam@gmail.com>"
    ],
    "license": "MIT OR Apache-2.0",
    "readme": "README.md",
    "repository": "https://github.com/rust-lang/regex",
    "documentation": "https://docs.rs/regex",
    "homepage": "https://github.com/rust-lang/regex",
    "description": "An implementation of regular expressions for Rust. This implementation uses\nfinite automata and guarantees linear time matching on all inputs.\n",
    "categories": [
      "text-processing"
    ],
    "autotests": false,
    "exclude": [
      "/scripts/*",
      "/.github/*"
    ],
    "edition": "2021",
    "rust-version": "1.65",
    "metadata": {
      "docs": {
        "rs": {
          "all-features": true,
          "rustdoc-args": [
            "--cfg",
            "docsrs"
          ]
        }
      }
    }
  },
  "workspace": {
    "members": [
      "regex-automata",
      "regex-capi",
      "regex-cli",
      "regex-lite",
      "regex-syntax",
      "regex-test"
    ]
  },
  "features": {
    "default": [
      "std",
      "perf",
      "unicode",
      "regex-syntax/default"
    ],
    "std": [
      "aho-corasick?/std",
      "memchr?/std",
      "regex-automata/std",
      "regex-syntax/std"
    ],
    "logging": [
      "aho-corasick?/logging",
      "memchr?/logging",
      "regex-automata/logging"
    ],
    "use_std": [
      "std"
    ],
    "perf": [
      "perf-cache",
      "perf-dfa",
      "perf-onepass",
      "perf-backtrack",
      "perf-inline",
      "perf-literal"
    ],
    "perf-dfa": [
      "regex-automata/hybrid"
    ],
    "perf-dfa-full": [
      "regex-automata/dfa-build",
      "regex-automata/dfa-search"
    ],
    "perf-onepass": [
      "regex-automata/dfa-onepass"
    ],
    "perf-backtrack": [
      "regex-automata/nfa-backtrack"
    ],
    "perf-inline": [
      "regex-automata/perf-inline"
    ],
    "perf-literal": [
      "dep:aho-corasick",
      "dep:memchr",
      "regex-automata/perf-literal"
    ],
    "perf-cache": [],
    "unicode": [
      "unicode-age",
      "unicode-bool",
      "unicode-case",
      "unicode-gencat",
      "unicode-perl",
      "unicode-script",
      "unicode-segment",
      "regex-automata/unicode",
      "regex-syntax/unicode"
    ],
    "unicode-age": [
      "regex-automata/unicode-age",
      "regex-syntax/unicode-age"
    ],
    "unicode-bool": [
      "regex-automata/unicode-bool",
      "regex-syntax/unicode-bool"
    ],
    "unicode-case": [
      "regex-automata/unicode-case",
      "regex-syntax/unicode-case"
    ],
    "unicode-gencat": [
      "regex-automata/unicode-gencat",
      "regex-syntax/unicode-gencat"
    ],
    "unicode-perl": [
      "regex-automata/unicode-perl",
      "regex-automata/unicode-word-boundary",
      "regex-syntax/unicode-perl"
    ],
    "unicode-script": [
      "regex-automata/unicode-script",
      "regex-syntax/unicode-script"
    ],
    "unicode-segment": [
      "regex-automata/unicode-segment",
      "regex-syntax/unicode-segment"
    ],
    "unstable": [
      "pattern"
    ],
    "pattern": []
  },
  "dependencies": {
    "aho-corasick": {
      "version": "1.0.0",
      "optional": true,
      "default-features": false
    },
    "memchr": {
      "version": "2.6.0",
      "optional": true,
      "default-features": false
    },
    "regex-automata": {
      "path": "regex-automata",
      "version": "0.4.8",
      "default-features": false,
      "features": [
        "alloc",
        "syntax",
        "meta",
        "nfa-pikevm"
      ]
    },
    "regex-syntax": {
      "path": "regex-syntax",
      "version": "0.8.5",
      "default-features": false
    }
  },
  "dev-dependencies": {
    "once_cell": "1.17.1",
    "quickcheck": {
      "version": "1.0.3",
      "default-features": false
    },
    "doc-comment": "0.3",
    "anyhow": "1.0.69",
    "regex-test": {
      "path": "regex-test",
      "version": "0.1.0"
    },
    "env_logger": {
      "version": "0.9.3",
      "default-features": false,
      "features": [
        "atty",
        "humantime",
        "termcolor"
      ]
    }
  },
  "test": [
    {
      "path": "tests/lib.rs",
      "name": "integration"
    }
  ],
  "profile": {
    "release": {
      "debug": true
    },
    "bench": {
      "debug": true
    },
    "dev": {
      "opt-level": 3,
      "debug": true
    },
    "test": {
      "opt-level": 3,
      "debug": true
    }
  }
}
