{
  "name": "@preventive/compare",
  "version": "0.0.0",
  "description": "Two file trees compared as git diff compares them: every file added, deleted, modified, renamed or changed in type, with its line change set, and the patch git writes; and JavaScript minified on both sides diffed with its renamed names set aside",
  "type": "module",
  "main": "./compare.js",
  "types": "./compare.d.ts",
  "exports": {
    ".": {
      "types": "./compare.d.ts",
      "default": "./compare.js"
    },
    "./compare.js": {
      "types": "./compare.d.ts",
      "default": "./compare.js"
    },
    "./names.js": {
      "types": "./names.d.ts",
      "default": "./names.js"
    }
  },
  "imports": {
    "#same-bytes": {
      "node": "./src/same-bytes.node.js",
      "default": "./src/same-bytes.js"
    },
    "#oxc": {
      "node": "./src/oxc.node.js",
      "default": "./src/oxc.js"
    }
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "compare.d.ts",
    "compare.js",
    "names.d.ts",
    "names.js",
    "src/blocks.js",
    "src/changes.js",
    "src/error.js",
    "src/names/analyze.js",
    "src/names/binds.js",
    "src/names/check.js",
    "src/names/marked.js",
    "src/names/misread.js",
    "src/names/pairing.js",
    "src/names/rename.js",
    "src/names/syntax.js",
    "src/oxc.js",
    "src/oxc.node.js",
    "src/patch.js",
    "src/quote.js",
    "src/renames.js",
    "src/same-bytes.js",
    "src/same-bytes.node.js",
    "src/similarity.js",
    "src/text.js",
    "src/tree.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreventiveMeasures/libraries.git",
    "directory": "compare"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/compare",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "@preventive/diff": "workspace:^"
  },
  "peerDependencies": {
    "oxc-minify": ">=0.152.0",
    "oxc-parser": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "oxc-minify": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preventive/archive": "workspace:*",
    "@preventive/vfs": "workspace:*",
    "oxc-minify": "^0.152.0",
    "oxc-parser": "^0.152.0"
  }
}
