{
  "name": "@preventive/compare",
  "version": "1.2.6",
  "description": "Git-compatible file tree diffs and minified JavaScript comparison",
  "type": "module",
  "main": "./compare.js",
  "types": "./compare.d.ts",
  "exports": {
    ".": {
      "types": "./compare.d.ts",
      "default": "./compare.js"
    },
    "./compare.js": {
      "types": "./compare.d.ts",
      "default": "./compare.js"
    },
    "./names.js": {
      "types": "./names.d.ts",
      "default": "./names.js"
    },
    "./pretty.js": {
      "types": "./pretty.d.ts",
      "default": "./pretty.js"
    }
  },
  "imports": {
    "#same-bytes": {
      "node": "./src/same-bytes.node.js",
      "default": "./src/same-bytes.js"
    },
    "#oxc": {
      "node": "./src/oxc.node.js",
      "default": "./src/oxc.js"
    },
    "#types": {
      "node": "./src/types.node.js",
      "default": "./src/types.js"
    }
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "compare.d.ts",
    "compare.js",
    "names.d.ts",
    "names.js",
    "pretty.d.ts",
    "pretty.js",
    "src/blocks.js",
    "src/changes.js",
    "src/chunks.js",
    "src/css.js",
    "src/erasure.js",
    "src/error.js",
    "src/layout.js",
    "src/marked.js",
    "src/names/analyze.js",
    "src/names/binds.js",
    "src/names/check.js",
    "src/names/diff.js",
    "src/names/misread.js",
    "src/names/pairing.js",
    "src/names/rename.js",
    "src/names/syntax.js",
    "src/oxc.js",
    "src/oxc.node.js",
    "src/patch.js",
    "src/pairs.js",
    "src/paths.js",
    "src/peers.js",
    "src/pretty.js",
    "src/quote.js",
    "src/renames.js",
    "src/same-bytes.js",
    "src/same-bytes.node.js",
    "src/script.js",
    "src/similarity.js",
    "src/text.js",
    "src/tree.js",
    "src/types.js",
    "src/types.node.js",
    "src/whitespace.js",
    "src/words.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreventiveMeasures/libraries.git",
    "directory": "compare"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/compare",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "@preventive/diff": "^1.0.2"
  },
  "peerDependencies": {
    "css-tree": ">=3.2.1",
    "oxc-minify": ">=0.152.0",
    "oxc-parser": ">=0.152.0",
    "oxfmt": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "css-tree": {
      "optional": true
    },
    "oxc-minify": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preventive/archive": "workspace:*",
    "@preventive/vfs": "workspace:*",
    "css-tree": "^3.2.1",
    "oxc-minify": "^0.152.0",
    "oxc-parser": "^0.152.0",
    "oxfmt": "^0.72.0"
  }
}
