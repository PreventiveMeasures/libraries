{
  "name": "@preventive/ai",
  "version": "0.0.0",
  "description": "Generic AI client",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "imports": {
    "#assert": {
      "browser": "./src/assert.browser.js",
      "default": "./src/assert.js"
    },
    "#chrome": {
      "browser": "./src/chrome/browser.js",
      "default": "./src/chrome/index.js"
    },
    "#env": {
      "browser": "./src/env.browser.js",
      "default": "./src/env.js"
    },
    "#fetch": {
      "browser": "./src/fetch.browser.js",
      "default": "./src/fetch.js"
    },
    "#fs": {
      "browser": "./src/fs.browser.js",
      "default": "./src/fs.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "src/assert.browser.js",
    "src/assert.js",
    "src/cache-history.js",
    "src/cache-normalize.js",
    "src/cache-scan.js",
    "src/cache.js",
    "src/chat.js",
    "src/chrome/browser.js",
    "src/chrome/index.js",
    "src/chrome/model.js",
    "src/chrome/profile.js",
    "src/chrome/wire.js",
    "src/env.browser.js",
    "src/env.js",
    "src/fetch-json.js",
    "src/fetch.browser.js",
    "src/fetch.js",
    "src/fs.browser.js",
    "src/fs.js",
    "src/model-table.js",
    "src/models.js",
    "src/ollama.js",
    "src/prefix-gate.js",
    "src/prompt-cache.js",
    "src/providers.js",
    "src/task-budget.js",
    "src/tool-results.js",
    "src/wire-formats.js"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.js"
  },
  "license": "MIT",
  "author": {
    "name": "Nikita Skovoroda",
    "email": "chalkerx@gmail.com",
    "url": "https://github.com/ChALkeR"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PreventiveMeasures/libraries.git",
    "directory": "ai"
  },
  "bugs": {
    "url": "https://github.com/PreventiveMeasures/libraries/issues"
  },
  "homepage": "https://github.com/PreventiveMeasures/libraries/tree/main/ai",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chalker/queue": "^1.0.1",
    "undici": "^8.0.3"
  },
  "peerDependencies": {
    "playwright-core": "^1.58.2"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "^1.58.2"
  }
}
